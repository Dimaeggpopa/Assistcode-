<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/keyboard_bg">

    <!-- AI action toolbar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/toolbar_bg"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <Button
                android:id="@+id/btnAiRewrite"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_action_rewrite"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnAiGrammar"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_action_grammar"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnAiShorter"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_action_shorter"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnAiFriendly"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_action_friendly"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textAllCaps="false" />

            <ProgressBar
                android:id="@+id/aiProgress"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:visibility="gone" />
        </LinearLayout>
    </HorizontalScrollView>

    <android.inputmethodservice.KeyboardView
        android:id="@+id/keyboardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:keyBackground="@drawable/key_background"
        android:keyTextColor="@color/key_text"
        android:keyTextSize="20sp"
        android:background="@color/keyboard_bg"
        android:shadowRadius="0" />

</LinearLayout>
